# project_name carries a region suffix so account-global IAM resource names
# (role/policy/user) do not collide with a same-account deploy in another region.
aws_region   = "us-west-2"
project_name = "aws-osmo-usw2"
environment  = "dev-repro"

# G7e (RTX PRO 6000) is offered in all four us-west-2 AZs. Spread Karpenter
# private subnets across a/b/c/d so GPU nodes can fall back to whichever AZ has
# on-demand capacity (2a/2b can exhaust). EKS + stateful services stay on the
# first two AZs via az_count. Leaving availability_zones empty resolves the same
# four AZs from main.tf's g7e_azs_by_region map.
availability_zones = ["us-west-2a", "us-west-2b", "us-west-2c", "us-west-2d"]
az_count           = 2
karpenter_az_count = 4

# The EKS API endpoint is private-only by default. Add narrow CIDRs only when
# your network path requires temporary public access. Never 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = []

single_nat_gateway = true

eks_cluster_version = "1.35"

# us-west-2 offers postgres 16.9-16.14; db.t4g.medium supports 16.9 minimum.
postgres_engine_version = "16.9"

system_node_instance_types = ["m7i.2xlarge"]
system_node_min_size       = 3
system_node_desired_size   = 3
system_node_max_size       = 5

reference_ha        = false
deletion_protection = false

tags = {
  Project     = "aws-osmo-usw2"
  Environment = "dev-repro"
}
