rent="1"><mxGeometry x="60" y="760" width="78" height="78" as="geometry"/></mxCell><mxCell id="alb" value="ALB HTTPS 리스너&lt;br&gt;기본 동작 authenticate-cognito&lt;br&gt;규칙: /api/health, /api/logout, /api/v1/* 우회" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="cloud"><mxGeometry x="120" y="300" width="78" height="78" as="geometry"/></mxCell><mxCell id="cognito" value="Cognito User Pool us-east-1_YpnKXG6LG&lt;br&gt;Managed Login v2 (다크 테마)&lt;br&gt;앱 클라이언트 alb · scopes openid/email/profile" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="cloud"><mxGeometry x="120" y="40" width="78" height="78" as="geometry"/></mxCell><mxCell id="admin" value="플랫폼 설정 (관리자) → Cognito&lt;br&gt;ListUsers · ListGroups · AdminCreateUser(SUPPRESS) · AdminSetUserPassword(Permanent)&lt;br&gt;AdminAddUserToGroup / AdminRemoveUserFromGroup · 감사 로그 조회 · SYS/SETTINGS 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="cloud"><mxGeometry x="40" y="600" width="620" height="110" as="geometry"/></mxCell><mxCell id="tokens" value="자격증명·API 토큰 화면&lt;br&gt;토큰 pai_&amp;lt;43자&amp;gt;는 SHA-256 해시만 저장, 1–30일 만료,&lt;br&gt;scope workflows/datasets/sessions/models/metrics (:read/:write)&lt;br&gt;roleCeiling = 실시간 Cognito AdminGetUser + AdminListGroupsForUser ∧ 프로젝트 멤버십 (캐시 없음)&lt;br&gt;자격증명은 값 대신 ref 를 워크플로에 전달, rotate 는 PutParameter Overwrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="cloud"><mxGeometry x="40" y="760" width="620" height="150" as="geometry"/></mxCell><mxCell id="proxy" value="web · src/proxy.ts (Next.js 미들웨어)&lt;br&gt;1. x-amzn-oidc-data (ES256) 서명 검증 — ELB 공개키, signer == ALB ARN, iss == user pool&lt;br&gt;2. x-amzn-oidc-accesstoken → Cognito JWKS 검증, cognito:groups 추출&lt;br&gt;3. 신뢰 헤더 x-pai-user / subject / email / role / project 주입&lt;br&gt;4. /api/v1/* + Bearer 토큰 → SHA-256 조회 → 프로젝트·scope 제한 후 /api/* 로 재작성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="vpc"><mxGeometry x="60" y="60" width="640" height="190" as="geometry"/></mxCell><mxCell id="route" value="route(minRole, handler, {audit}) · src/server/api.ts&lt;br&gt;역할 순위 viewer &amp;lt; researcher &amp;lt; admin (Cognito 그룹 admins / researchers)&lt;br&gt;프로젝트 역할 viewer / researcher / project-admin (DynamoDB PROJECT#&amp;lt;id&amp;gt; 멤버)&lt;br&gt;브라우저 변경 요청은 same-origin 강제 · 모든 non-GET 은 AUDIT 파티션에 90일 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="vpc"><mxGeometry x="60" y="300" width="640" height="150" as="geometry"/></mxCell><mxCell id="web" value="web (Next.js)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="vpc"><mxGeometry x="340" y="520" width="78" height="78" as="geometry"/></mxCell><mxCell id="me" value="GET /api/me → 사용자·역할·features·resources·선택 프로젝트&lt;br&gt;POST /api/auth/logout → gateway 세션 회수 → GET /api/logout → Cognito /logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="vpc"><mxGeometry x="60" y="680" width="640" height="90" as="geometry"/></mxCell><mxCell id="ddb" value="DynamoDB&lt;br&gt;API_TOKEN#&amp;lt;sha256&amp;gt; · PROJECT#&amp;lt;id&amp;gt;/TOKEN#&lt;br&gt;PROJECT#&amp;lt;id&amp;gt;/META 멤버 · AUDIT" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="cloud"><mxGeometry x="1620" y="300" width="78" height="78" as="geometry"/></mxCell><mxCell id="ssm" value="SSM Parameter Store&lt;br&gt;/physical-ai/projects/&amp;lt;p&amp;gt;/{users/&amp;lt;sha&amp;gt;|shared}/&amp;lt;id&amp;gt;&lt;br&gt;(HF/NGC 자격증명 SecureString)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.parameter_store;" vertex="1" parent="cloud"><mxGeometry x="1620" y="760" width="78" height="78" as="geometry"/></mxCell><mxCell id="secrets" value="Secrets Manager&lt;b