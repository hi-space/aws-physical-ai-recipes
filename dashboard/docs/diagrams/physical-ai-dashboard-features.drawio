ntSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="img"><mxGeometry x="400" y="300" width="78" height="78" as="geometry"/></mxCell><mxCell id="imgflow" value="승인 흐름: 소스 등록(S3/Git) → 빌드 → ECR digest → 이미지 프로필 '검사하고 승인 버전 저장'(관리자, 리비전 기록) → 워크플로 preflight 가 태스크별 정확히 1개 활성 프로필 요구,&lt;br&gt;큐 대기 중 승인 철회되면 launch 시 image_approval_changed 로 차단. 실행 프로필(host 권한)은 전용 노드 라벨/taint 와 승인 태스크 해시를 검사하는 별도 관리자 신뢰 경계." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="img"><mxGeometry x="60" y="450" width="920" height="60" as="geometry"/></mxCell><mxCell id="ssm" value="SSM Parameter Store&lt;br&gt;/physical-ai/projects/&amp;lt;p&amp;gt;/webhooks/&amp;lt;hook&amp;gt; (endpoint+secret)&lt;br&gt;/physical-ai/projects/&amp;lt;p&amp;gt;/… 자격증명" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.parameter_store;" vertex="1" parent="cloud"><mxGeometry x="1600" y="120" width="78" height="78" as="geometry"/></mxCell><mxCell id="hook" value="웹훅 수신 endpoint (HTTPS 443만)&lt;br&gt;x-pai-event-id · x-pai-timestamp&lt;br&gt;x-pai-signature v1=HMAC-SHA256(ts.eventId.body)&lt;br&gt;사설 IP 거부 · 리다이렉트 없음 · 10초" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet;" vertex="1" parent="cloud"><mxGeometry x="1950" y="120" width="78" height="78" as="geometry"/></mxCell><mxCell id="ctrl" value="controller 워커&lt;br&gt;deliverWebhooks (5초, 8회/24h 백오프)&lt;br&gt;reconcileSourceBuilds · refreshBackendChecks" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="cloud"><mxGeometry x="1600" y="420" width="78" height="78" as="geometry"/></mxCell><mxCell id="iot" value="AWS IoT Core&lt;br&gt;DescribeThingGroup · ListThingsInThingGroup&lt;br&gt;DescribeThing" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="edge"><mxGeometry x="60" y="80" width="78" height="78" as="geometry"/></mxCell><mxCell id="gg" value="IoT Greengrass v2&lt;br&gt;GetCoreDevice · ListInstalledComponents&lt;br&gt;GetComponent · CreateDeployment(:thing/ 만, ROLLBACK)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.greengrass;" vertex="1" parent="edge"><mxGeometry x="400" y="80" width="78" height="78" as="