{
  "name": "isaac-lab-groot-finetune",
  "version": "1.0.0",
  "description": "GR00T VLA fine-tuning infrastructure on AWS Batch (shares DCV/EFS with infra/isaaclab)",
  "scripts": {
    "cdk": "cdk",
    "build": "tsc",
    "test": "jest",
    "synth": "cdk synth",
    "resolve": "ts-node bin/resolve-parent-stack.ts",
    "update-config": "ts-node bin/update-config.ts",
    "deploy:shared": "cdk deploy GrootFinetuneShared --require-approval never",
    "deploy": "cdk deploy GrootBatchTrain GrootFinetuneSagemaker --require-approval never",
    "destroy": "cdk destroy GrootBatchTrain GrootFinetuneSagemaker --force"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1041.0",
    "@aws-sdk/client-ec2": "^3.1041.0",
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "aws-cdk": "^2.180.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  }
}
